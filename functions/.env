# Settings for the customer platform (functions/app/). These aren't secrets: they're
# safe to commit. Keys and tokens go in Secret Manager instead (see README).

# "on" deploys the platform (the `app` and `launcher` functions). Leave it "off" until the four
# keys are in Secret Manager (README, "Going live with the platform").
PLATFORM=off

# "sandbox" = Square test cards only. Change to "production" to take real payments.
SQUARE_ENVIRONMENT=sandbox
# developer.squareup.com -> your app -> Credentials -> Application ID (sandbox or production).
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=LAET0GFY9RXSR
SQUARE_WEBHOOK_URL=https://webburrito.com/api/app/square-webhook

# Cloudflare dashboard -> any page -> Account ID (right-hand column).
CLOUDFLARE_ACCOUNT_ID=
SITES_WORKER_NAME=webburrito-sites

BUILD_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-sonnet-5-5
FREE_BUILDS=3
FREE_BUILDS_PER_DAY_TOTAL=150
MAX_DOMAIN_PRICE=15
MAX_DOMAINS_PER_DAY=10
PAST_DUE_GRACE_DAYS=14
LAUNCH_RETRY_SECONDS=60
# Test mode: who besides admins may try paying with Square test cards (comma-separated emails).
TEST_EMAILS=
SITE_ORIGIN=https://webburrito.com

ANTHROPIC_BASE_URL=https://api.anthropic.com
SQUARE_BASE_URL=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
